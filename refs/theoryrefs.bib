
@article{lorena_how_2020,
	title = {How {Complex} {Is} {Your} {Classification} {Problem}?: {A} {Survey} on {Measuring} {Classification} {Complexity}},
	volume = {52},
	issn = {0360-0300, 1557-7341},
	shorttitle = {How {Complex} {Is} {Your} {Classification} {Problem}?},
	url = {https://dl.acm.org/doi/10.1145/3347711},
	doi = {10.1145/3347711},
	abstract = {Characteristics extracted from the training datasets of classification problems have proven to be effective predictors in a number of meta-analyses. Among them, measures of classification complexity can be used to estimate the difficulty in separating the data points into their expected classes. Descriptors of the spatial distribution of the data and estimates of the shape and size of the decision boundary are among the known measures for this characterization. This information can support the formulation of new data-driven pre-processing and pattern recognition techniques, which can in turn be focused on challenges highlighted by such characteristics of the problems. This article surveys and analyzes measures that can be extracted from the training datasets to characterize the complexity of the respective classification problems. Their use in recent literature is also reviewed and discussed, allowing to prospect opportunities for future work in the area. Finally, descriptions are given on an R package named Extended Complexity Library (ECoL) that implements a set of complexity measures and is made publicly available.},
	language = {en},
	number = {5},
	urldate = {2022-05-30},
	journal = {ACM Computing Surveys},
	author = {Lorena, Ana C. and Garcia, Luís P. F. and Lehmann, Jens and Souto, Marcilio C. P. and Ho, Tin Kam},
	month = sep,
	year = {2020},
	keywords = {Backpropagation, BNC, C4.5, Case Base Complexity Profile, CB, centroid-based, Class Balance, class density in overlap region, Classification, Collective entropy, Collective Feature Efficiency, Complexity, Complexity Measures, DAG, Data compactness, DCoL, DCP, Decision Tree, Directed Acyclic Graph, Directional Vector, discriminative capability, Disjunct Class Percentage, Disjunct Size, Distance:Bhattacharyya, Distance:Hellinger, Distance:Kullback-Leibler, Distance:Mahalanobis, DS, Dynamic Selection, ECoL, Extreme Learning Machines, FBP, Fraction of Borderline Points, GraphNN, HM, Hypothesis margin, incremental learning, instance hardness, Ipoints, k-Disagreeing Neighbors, kDN, kNN, Kolmogorov complexity, Language:R, LSC, Maximum Individual Feature Efficiency, Meta-learning, Minimal spanning tree, Minority Value, MRCA, MRI, MST, Multi-resolution Complexity Analysis, Multiresolution Index, MV, Nearst Neightbour, Neural network, NN, Normal Information Radius, number of invasive points, one-versus-one, OVO, Prim’s algorithm, random decision forests, RDP, Recursive Deterministic Perceptron, Review, Separability Index, SI, Sparsity, Subsample Decision Forest, Subspace Decision Forest, Supervised learning, SVM, TD, Tree Depth, volume of local neighborhood},
	pages = {1--34},
	file = {Lorena et al. - 2020 - How Complex Is Your Classification Problem A Sur.pdf:C\:\\Users\\Lesley\\Zotero\\storage\\C4TNQ3GU\\Lorena et al. - 2020 - How Complex Is Your Classification Problem A Sur.pdf:application/pdf},
