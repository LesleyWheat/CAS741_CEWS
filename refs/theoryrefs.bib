	pages = {289--300},
	file = {IEEE Xplore Abstract Record:C\:\\Users\\Lesley\\Zotero\\storage\\GYJFJLJX\\990132.html:text/html;IEEE Xplore Full Text PDF:C\:\\Users\\Lesley\\Zotero\\storage\\UBC8EM7R\\Ho and Basu - 2002 - Complexity measures of supervised classification p.pdf:application/pdf},
